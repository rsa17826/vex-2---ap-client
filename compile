#!/usr/bin/env bash
set -euo pipefail

# Config
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$PROJECT_DIR/scripts"
BASE_SWF="$PROJECT_DIR/vex2.swf"
OUT_SWF="$PROJECT_DIR/vex2-modded.swf"
TRACKED_FILE="$PROJECT_DIR/.modded_files"
HASH_FILE="$PROJECT_DIR/.modded_hashes"
IMPORT_DIR="$PROJECT_DIR/.import_staging"
RABCDASM_DIR="$PROJECT_DIR/RABCDAsm"

# Ensure tracked-files list exists
touch "$TRACKED_FILE"

# Add any files passed as arguments to the tracked list (if not already present)
for f in "$@"; do
  rel="${f#"$SCRIPTS_DIR"/}"
  rel="${rel#scripts/}"

  if [[ ! -f "$SCRIPTS_DIR/$rel" ]]; then
    echo "Error: $SCRIPTS_DIR/$rel does not exist" >&2
    exit 1
  fi

  if ! grep -qxF "$rel" "$TRACKED_FILE"; then
    echo "Adding $rel to tracked mod files"
    echo "$rel" >>"$TRACKED_FILE"
    echo "!scripts/$rel" >>".gitignore"
  fi
done

if [[ ! -s "$TRACKED_FILE" ]]; then
  echo "No tracked files yet. Usage: ./compile <file.as> [more files...]" >&2
  exit 1
fi

touch "$HASH_FILE"

# Decide whether we can do an incremental compile: only possible if a
# previously-built vex2-modded.swf already exists, since that's the file
# we'd import the unchanged scripts' bytecode from / build on top of.
INCREMENTAL=0
IMPORT_BASE="$BASE_SWF"
if [[ -f "$OUT_SWF" ]]; then
  INCREMENTAL=1
  IMPORT_BASE="$OUT_SWF"
  echo "Found existing $(basename "$OUT_SWF") - checking for changed files (incremental compile)"
fi

get_stored_hash() {
  awk -F'::' -v r="$1" '$1==r{print $2; found=1} END{if(!found) exit 1}' "$HASH_FILE" 2>/dev/null
}

# Determine which tracked files actually changed since the last compile
CHANGED=()
UNCHANGED=()
while IFS= read -r rel; do
  [[ -z "$rel" ]] && continue
  current_hash=$(sha256sum "$SCRIPTS_DIR/$rel" | awk '{print $1}')
  if [[ "$INCREMENTAL" -eq 1 ]]; then
    if stored_hash=$(get_stored_hash "$rel") && [[ "$stored_hash" == "$current_hash" ]]; then
      UNCHANGED+=("$rel")
      continue
    fi
  fi
  CHANGED+=("$rel")
done <"$TRACKED_FILE"

# Stage only the files that need (re)compiling, preserving their relative
# package paths
rm -rf "$IMPORT_DIR"
mkdir -p "$IMPORT_DIR"

if [[ "${#CHANGED[@]}" -eq 0 ]]; then
  echo "No tracked files changed since last compile - skipping ffdec import."
else
  echo "Staging changed files:"
  for rel in "${CHANGED[@]}"; do
    echo "  - $rel"
    mkdir -p "$IMPORT_DIR/$(dirname "$rel")"
    cp "$SCRIPTS_DIR/$rel" "$IMPORT_DIR/$rel"
  done

  if [[ "${#UNCHANGED[@]}" -gt 0 ]]; then
    echo "Skipping unchanged files:"
    for rel in "${UNCHANGED[@]}"; do
      echo "  - $rel"
    done
  fi

  # Run FFDec import for the changed files, building on top of the existing
  # modded swf when doing an incremental compile so unchanged bytecode is
  # left alone.
  echo "Running ffdec importScript..."
  ffdec -importScript "$IMPORT_BASE" "$OUT_SWF" "$IMPORT_DIR"
fi

# --- DYNAMIC MULTI-ABC POST-PROCESS OVERRIDE ---
for filepath in "$PROJECT_DIR"/asasm/*; do
  if [[ -f "$filepath" ]]; then
    filename=$(basename "$filepath")
    echo "Applying RABCDAsm dynamic post-patch for $filename..."
    WORK_DIR="$PROJECT_DIR/workspace"
    rm -rf "$WORK_DIR"
    mkdir -p "$WORK_DIR"
    cp "$OUT_SWF" "$WORK_DIR/target.swf"

    cd "$WORK_DIR"
    "$RABCDASM_DIR/abcexport" target.swf

    # Loop through all exported ABC files to find where the file lives
    patched=0
    for abc_file in target-*.abc; do
      index="${abc_file#target-}"
      index="${index%.abc}"

      # Clean and disassemble this specific ABC index
      rm -rf "target-$index"
      "$RABCDASM_DIR/rabcdasm" "$abc_file"

      # Check if this ABC file contains the file
      if [[ -f "target-$index/$filename" ]]; then
        echo "Found $filename inside ABC index $index!"

        # Overwrite with your custom modded files
        cp "$filepath" "target-$index/"

        # Reassemble and inject back into the correct index
        "$RABCDASM_DIR/rabcasm" "target-$index/target-$index.main.asasm"
        "$RABCDASM_DIR/abcreplace" target.swf "$index" "target-$index/target-$index.main.abc"

        patched=1
        break
      fi
    done

    if [[ $patched -eq 0 ]]; then
      echo "Error: Could not find $filename in any ABC tag of this SWF!" >&2
      exit 1
    fi

    cp target.swf "$OUT_SWF"
    cd "$PROJECT_DIR"
    echo "RABCDAsm post-patch applied successfully!"
  fi
done

python patch_swf.py "$OUT_SWF" "$OUT_SWF"

# Record fresh hashes for every currently-tracked file so the next run can
# tell what changed. This rewrites the hash file (dropping entries for files
# that are no longer tracked).
: >"$HASH_FILE"
while IFS= read -r rel; do
  [[ -z "$rel" ]] && continue
  current_hash=$(sha256sum "$SCRIPTS_DIR/$rel" | awk '{print $1}')
  echo "${rel}::${current_hash}" >>"$HASH_FILE"
done <"$TRACKED_FILE"

echo ""
echo "Done. Output: $OUT_SWF"
if [[ "$INCREMENTAL" -eq 1 ]]; then
  echo "Mode: incremental (${#CHANGED[@]} changed, ${#UNCHANGED[@]} unchanged)"
else
  echo "Mode: full compile"
fi
echo "Tracked files ($(wc -l <"$TRACKED_FILE" | tr -d ' ')):"
cat "$TRACKED_FILE"
